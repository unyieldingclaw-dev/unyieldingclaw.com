---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<!-- workshop-v2 -->
<BaseLayout
  title="Nolan's Workshop"
  description="Nolan's Workshop: woodworking projects, shop systems, jigs, work surfaces, finishing, tools, and build lessons."
>
  <header class="subhero subhero--workshop">
    <div class="shell subhero-grid">
      <div class="subhero-copy">
        <div class="subhero-badges">
          <span>WOOD</span>
          <span>TOOLS</span>
          <span>JIGS</span>
          <span>BUILD LOG</span>
        </div>
        <p class="subhero-kicker">NOLAN'S WORKSHOP // BUILT TO BE USED</p>
        <h1>Sawdust is just another kind of debugging.</h1>
        <p class="lede">
          Shop systems, jigs, work surfaces, furniture, finishing, and practical builds where the useful part is often the decision that changed halfway through.
        </p>
        <div class="hero-actions">
          <a class="button workshop-button" href="#workshop-zones">Enter the shop ↓</a>
          <a class="button secondary workshop-secondary" href="/about/">Meet the builder</a>
        </div>
      </div>

      <aside class="workshop-bench" aria-label="Workshop build philosophy">
        <div class="bench-rule bench-rule--top"></div>
        <div class="bench-stamp egg-mark egg-mark--workshop" data-egg="NO FANTASY SHOP REQUIRED">NOLAN'S<br/>WORKSHOP</div>
        <button class="trail-marker trail-marker--workshop" type="button" data-trail-marker="workshop-trail" aria-label="Hidden trail marker: Sawdust Trail">◇</button>
        <div class="bench-note">
          <span>01</span>
          <strong>Fit the workflow</strong>
          <small>Not the fantasy shop.</small>
        </div>
        <div class="bench-note">
          <span>02</span>
          <strong>Use what I own</strong>
          <small>Buy only when the gap is real.</small>
        </div>
        <div class="bench-note">
          <span>03</span>
          <strong>Prototype, test, revise</strong>
          <small>The first cut is not sacred.</small>
        </div>
        <div class="bench-rule bench-rule--bottom"></div>
      </aside>
    </div>
  </header>

  <section class="section section--warm workshop-zones" id="workshop-zones">
    <div class="shell">
      <div class="section-heading section-heading--punch">
        <div>
          <p class="eyebrow">What lives here</p>
          <h2>Systems for the shop. Projects for the fun of it.</h2>
        </div>
        <p class="section-intro">
          Nolan's Workshop is the physical-build side of the same builder brain: solve the actual problem, respect the constraints, and don't turn the tool into a bigger project than the work.
        </p>
      </div>

      <div class="workshop-grid workshop-grid--wow">
        <article class="workshop-card workshop-card--jigs">
          <span class="workshop-card__number">01</span>
          <h3>Shop systems & jigs</h3>
          <p>Purpose-built sleds, stands, storage, workholding, and fixtures that make repeated work faster, safer, or more accurate.</p>
        </article>
        <article class="workshop-card workshop-card--furniture">
          <span class="workshop-card__number">02</span>
          <h3>Work surfaces & furniture</h3>
          <p>Benches, tables, tops, and utility builds where structure, mobility, finish, and real use beat showroom perfection.</p>
        </article>
        <article class="workshop-card workshop-card--experiments">
          <span class="workshop-card__number">03</span>
          <h3>Small builds & experiments</h3>
          <p>Routing, joinery, finishing, material choices, mistakes, revisions, and the occasional “that should probably work” prototype.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section workshop-playground">
    <div class="shell">
      <div class="section-heading section-heading--punch">
        <div>
          <p class="eyebrow">Shop rules are more like guidelines</p>
          <h2>Please keep hands clear of the imaginary blade.</h2>
        </div>
        <p class="section-intro">
          Some pages have hover effects. The Workshop has power tools. Move around. You'll figure it out.
        </p>
      </div>

      <div class="workshop-play-grid">
        <div class="saw-cut-stage" data-saw-cut tabindex="0" role="button" aria-label="Run the circular saw easter egg">
          <div class="saw-cut-reveal">
            <span>OFFCUT REMOVED</span>
            <strong>Measure twice. Cut once.</strong>
            <small>Stare at it for 20 minutes anyway.</small>
          </div>

          <div class="saw-cut-slab saw-cut-slab--top" aria-hidden="true">
            <div class="saw-cut-grain"></div>
            <span>NOLAN'S WORKSHOP</span>
          </div>
          <div class="saw-cut-slab saw-cut-slab--bottom" aria-hidden="true">
            <div class="saw-cut-grain"></div>
            <small>BUILT TO BE USED</small>
          </div>

          <div class="saw-cut-line" aria-hidden="true"></div>
          <div class="circular-saw circular-saw--svg" data-circular-saw aria-hidden="true">
            <svg viewBox="0 0 240 150" role="presentation" focusable="false">
              <defs>
                <linearGradient id="sawBody" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#f0c84b"/>
                  <stop offset="42%" stop-color="#c98f27"/>
                  <stop offset="100%" stop-color="#765018"/>
                </linearGradient>
                <linearGradient id="sawMetal" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#f4f6f7"/>
                  <stop offset="35%" stop-color="#aab2b7"/>
                  <stop offset="68%" stop-color="#697277"/>
                  <stop offset="100%" stop-color="#c9d0d4"/>
                </linearGradient>
                <linearGradient id="sawDark" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#4a4337"/>
                  <stop offset="100%" stop-color="#181b1d"/>
                </linearGradient>
                <radialGradient id="bladeMetal" cx="45%" cy="38%" r="65%">
                  <stop offset="0%" stop-color="#f7f8f8"/>
                  <stop offset="36%" stop-color="#cdd3d6"/>
                  <stop offset="72%" stop-color="#889196"/>
                  <stop offset="100%" stop-color="#555d61"/>
                </radialGradient>
                <filter id="sawShadow" x="-30%" y="-30%" width="170%" height="190%">
                  <feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#000" flood-opacity=".32"/>
                </filter>
              </defs>

              <g filter="url(#sawShadow)">
                <path class="saw-svg__shoe" d="M11 125 L218 125 L231 133 L220 141 L16 141 L7 135 Z" fill="url(#sawMetal)" stroke="#596166" stroke-width="2"/>
                <path d="M17 128 L218 128" stroke="#fff" stroke-opacity=".48" stroke-width="2"/>

                <g class="saw-svg__blade-group">
                  <circle class="saw-svg__blade" cx="70" cy="103" r="49" fill="url(#bladeMetal)" stroke="#4f575b" stroke-width="3"/>
                  <g class="saw-svg__teeth" fill="#d8dde0" stroke="#596166" stroke-width="1">
                    <path d="M70 50 l5 -8 4 10 z"/>
                    <path d="M91 54 l8 -6 1 11 z"/>
                    <path d="M109 67 l10 -3 -3 11 z"/>
                    <path d="M119 87 l10 1 -7 9 z"/>
                    <path d="M121 109 l9 5 -10 6 z"/>
                    <path d="M113 130 l6 8 -11 2 z"/>
                    <path d="M95 145 l2 10 -10 -4 z"/>
                    <path d="M74 151 l-2 10 -8 -7 z"/>
                    <path d="M51 147 l-6 8 -4 -10 z"/>
                    <path d="M33 134 l-9 5 1 -11 z"/>
                    <path d="M21 115 l-10 1 5 -10 z"/>
                    <path d="M20 93 l-10 -3 8 -8 z"/>
                    <path d="M29 71 l-8 -7 11 -3 z"/>
                    <path d="M47 56 l-4 -9 11 1 z"/>
                  </g>
                  <circle cx="70" cy="103" r="12" fill="#4a5155" stroke="#b8c0c4" stroke-width="4"/>
                  <circle cx="70" cy="103" r="4" fill="#1f2325"/>
                </g>

                <path class="saw-svg__guard" d="M28 101 A49 49 0 0 1 116 73 L111 87 A34 34 0 0 0 43 103 Z"
                      fill="url(#sawMetal)" stroke="#5e666a" stroke-width="3"/>
                <path d="M35 88 A41 41 0 0 1 106 69" fill="none" stroke="#fff" stroke-opacity=".42" stroke-width="3"/>

                <path class="saw-svg__body"
                      d="M93 48 C105 33 132 29 164 33 L194 47 C207 53 214 66 211 81 L205 105 C202 115 194 121 182 121 L112 120 C99 120 90 110 90 97 L88 66 C88 59 89 54 93 48 Z"
                      fill="url(#sawBody)" stroke="#6f4a15" stroke-width="3"/>
                <path d="M104 51 C125 39 160 40 190 54" fill="none" stroke="#fff" stroke-opacity=".2" stroke-width="4" stroke-linecap="round"/>

                <g class="saw-svg__vents" stroke="#5c411d" stroke-width="3" stroke-linecap="round" opacity=".78">
                  <path d="M139 91 l0 17"/>
                  <path d="M147 89 l0 19"/>
                  <path d="M155 88 l0 20"/>
                  <path d="M163 89 l0 18"/>
                </g>

                <circle cx="188" cy="79" r="17" fill="#34393c" stroke="#7c8589" stroke-width="4"/>
                <circle cx="188" cy="79" r="8" fill="#1d2022"/>

                <path class="saw-svg__handle"
                      d="M112 52 C116 22 133 10 161 12 C181 13 194 26 196 44 L178 48 C176 36 168 29 156 28 C142 27 134 35 132 53 Z"
                      fill="url(#sawDark)" stroke="#17191a" stroke-width="3"/>
                <path d="M142 31 C151 25 165 27 173 36" fill="none" stroke="#6f6758" stroke-width="4" stroke-linecap="round"/>
                <rect x="166" y="41" width="17" height="8" rx="4" fill="#17191a"/>

                <path class="saw-svg__front-grip"
                      d="M86 59 C88 44 96 35 108 34 L119 37 L116 65 L101 73 Z"
                      fill="url(#sawDark)" stroke="#1b1d1e" stroke-width="3"/>
                <path d="M94 50 L111 47" stroke="#6e6658" stroke-width="3" stroke-linecap="round"/>

                <path d="M111 117 L202 117" stroke="#4f3d23" stroke-width="2" opacity=".5"/>
                <text x="181" y="111" font-family="ui-monospace, monospace" font-size="10" font-weight="900" fill="#5a3a11">7¼</text>
              </g>
            </svg>
          </div>
          <div class="sawdust-burst" data-saw-dust aria-hidden="true"></div>
          <span class="saw-cut-hint">hover here // yes, really</span>
        </div>

        <div class="sawdust-bench" data-sawdust-bench>
          <div class="sawdust-bench__engraving" data-bench-message>
            <span>BENCH TEST</span>
            <strong>Congratulations.</strong>
            <small>You have now cleaned more of my shop than I have today.</small>
          </div>
          <canvas data-sawdust-canvas aria-hidden="true"></canvas>

          <div class="sawdust-bench__wipe-cue" data-wipe-cue aria-hidden="true">
            <svg viewBox="0 0 58 42" focusable="false">
              <path d="M5 12 20 4l29 7 4 23-20 5L8 34Z" fill="#d9c7ad" stroke="#6f5a43" stroke-width="2"/>
              <path d="m20 4 4 13 29-6M8 34l19-12 6 17M24 17l3 5m0 0 13-5" fill="none" stroke="#9d876c" stroke-width="2" stroke-linecap="round"/>
              <path d="M5 12 27 22" fill="none" stroke="#f3eadf" stroke-width="1.6" opacity=".8"/>
            </svg>
            <span>Wipe the bench</span>
            <i aria-hidden="true"></i>
          </div>

          <div class="sawdust-bench__impact" data-bench-impact aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section workshop-process">
    <div class="shell process-grid">
      <div>
        <p class="eyebrow">Build process</p>
        <h2>Measure. Cut. Learn. Change the plan.</h2>
        <p class="section-intro">
          Project pages will document the problem, constraints, tools already on hand, build decisions, what failed, what changed, and what I would do differently next time.
        </p>
      </div>
      <div class="process-strip" aria-label="Workshop process">
        <div><span>01</span><strong>Need</strong></div>
        <div><span>02</span><strong>Sketch</strong></div>
        <div><span>03</span><strong>Build</strong></div>
        <div><span>04</span><strong>Use</strong></div>
        <div><span>05</span><strong>Revise</strong></div>
      </div>
    </div>
  </section>

  <section class="section section--dark workshop-crossover">
    <div class="shell bridge-grid">
      <div>
        <p class="eyebrow">The crossover</p>
        <h2>Good jigs and good software share a personality.</h2>
        <p class="section-intro">
          Narrow purpose. Predictable behavior. Respect for constraints. Enough simplicity that the tool does not become the project.
        </p>
      </div>
      <aside class="bridge-card bridge-card--copper">
        <span>CONTENT RIGHTS</span>
        <strong>Plans are deliberate, not automatically open source.</strong>
        <small>Photos, drawings, measurements, plans, and authored build content remain all rights reserved unless a specific project says otherwise.</small>
      </aside>
    </div>
  </section>

  <script is:inline>
    (() => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      const cutStage = document.querySelector('[data-saw-cut]');
      const dustBurst = document.querySelector('[data-saw-dust]');
      const bench = document.querySelector('[data-sawdust-bench]');
      const canvas = document.querySelector('[data-sawdust-canvas]');
      const wipeCue = bench?.querySelector('[data-wipe-cue]');
      const benchImpact = bench?.querySelector('[data-bench-impact]');

      let cutting = false;
      let cutComplete = false;
      let brushing = false;
      let benchDustStarted = false;
      let benchDustFinished = false;
      let benchRevealComplete = false;

      const cleanGrid = {
        columns: 18,
        rows: 12,
        threshold: 0.82,
        cells: new Set(),
      };

      const ctx = canvas?.getContext('2d');

      const sizeBenchCanvas = () => {
        if (!bench || !canvas || !ctx) return;
        const rect = bench.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.floor(rect.width * dpr);
        canvas.height = Math.floor(rect.height * dpr);
        canvas.style.width = rect.width + 'px';
        canvas.style.height = rect.height + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, rect.width, rect.height);
      };

      const clearBenchCompletely = () => {
        if (!bench || !canvas || !ctx) return;
        const rect = bench.getBoundingClientRect();
        ctx.clearRect(0, 0, rect.width, rect.height);
        bench.classList.remove('is-dusty', 'is-buried', 'is-cleaning', 'is-cleared', 'is-revealing', 'is-revealed');
        benchDustStarted = false;
        benchDustFinished = false;
        benchRevealComplete = false;
        cleanGrid.cells.clear();
      };

      const depositBenchDust = (progress, finalPass = false) => {
        if (!bench || !canvas || !ctx) return;
        const rect = bench.getBoundingClientRect();
        if (!rect.width || !rect.height) return;

        if (!benchDustStarted) {
          benchDustStarted = true;
          bench.classList.add('is-dusty');
        }

        ctx.save();
        ctx.globalCompositeOperation = 'source-over';

        const dustColors = [
          '#d8b77f',
          '#cda56d',
          '#e3c58f',
          '#b9854f',
          '#efd9ad',
          '#a96f3d'
        ];

        const drawParticle = (x, y, size, alpha, color, angle = 0, aspect = 1) => {
          ctx.save();
          ctx.translate(x, y);
          ctx.rotate(angle);
          ctx.scale(aspect, 1);
          ctx.beginPath();
          ctx.ellipse(0, 0, size, Math.max(0.35, size * 0.42), 0, 0, Math.PI * 2);
          ctx.fillStyle = color;
          ctx.globalAlpha = alpha;
          ctx.fill();
          ctx.restore();
        };

        const addRandomDust = (count, density = 1, centerBias = false) => {
          for (let i = 0; i < count; i++) {
            const biased = centerBias && Math.random() < 0.58;
            const x = biased
              ? rect.width * (0.16 + Math.random() * 0.68)
              : Math.random() * rect.width;

            // Fine dust settles everywhere, but there is a little more material
            // toward the lower half and left edge where the saw is feeding it.
            const settle = Math.pow(Math.random(), 0.82);
            let y = rect.height * (0.08 + settle * 0.9);
            if (Math.random() < 0.22) y = rect.height * (0.56 + Math.random() * 0.4);

            const fine = Math.random() < 0.86;
            const size = fine
              ? 0.35 + Math.random() * (1.35 + density * 0.75)
              : 1.8 + Math.random() * (3.6 + density * 1.3);

            const alpha = fine
              ? 0.24 + Math.random() * (0.34 + density * 0.12)
              : 0.34 + Math.random() * (0.36 + density * 0.12);

            const angle = Math.random() * Math.PI;
            const aspect = fine ? 0.75 + Math.random() * 1.3 : 1.2 + Math.random() * 2.4;
            const color = dustColors[Math.floor(Math.random() * dustColors.length)];

            drawParticle(x, y, size, alpha, color, angle, aspect);

            // Occasional paired flecks create little clumps instead of a perfect spray.
            if (!fine && Math.random() < 0.38) {
              drawParticle(
                x + (-4 + Math.random() * 8),
                y + (-3 + Math.random() * 6),
                size * (0.35 + Math.random() * 0.45),
                alpha * 0.72,
                dustColors[Math.floor(Math.random() * dustColors.length)],
                Math.random() * Math.PI,
                0.8 + Math.random() * 1.8
              );
            }
          }
        };

        const addBottomDrift = (count, strength) => {
          for (let i = 0; i < count; i++) {
            const x = Math.random() * rect.width;
            const edgeNoise = Math.sin(x * 0.031) * 6 + Math.sin(x * 0.073) * 3;
            const y = rect.height - (4 + Math.random() * (18 + strength * 34)) + edgeNoise;
            const size = 0.8 + Math.random() * (2.5 + strength * 2.4);
            const color = dustColors[Math.floor(Math.random() * dustColors.length)];

            drawParticle(
              x,
              Math.min(rect.height - 2, Math.max(rect.height * 0.64, y)),
              size,
              0.34 + Math.random() * 0.48,
              color,
              Math.random() * Math.PI,
              0.9 + Math.random() * 2.2
            );
          }
        };

        if (!finalPass) {
          // Each animation tick adds a little more mess. No smooth gradient,
          // just progressively denser particulate.
          addRandomDust(58, 0.35 + progress * 0.8, progress > 0.45);
          addBottomDrift(16, progress);
        } else {
          // Final pass: bury the message with dense, irregular fine dust.
          addRandomDust(2600, 1.15, true);
          addBottomDrift(900, 1.2);

          // A broad band of fine dust across the message area. Still granular:
          // many tiny specks, never a filled radial blob.
          for (let i = 0; i < 1600; i++) {
            const x = rect.width * (0.08 + Math.random() * 0.84);
            const y = rect.height * (0.27 + Math.random() * 0.5);
            const size = 0.35 + Math.random() * 1.8;
            const color = dustColors[Math.floor(Math.random() * dustColors.length)];

            drawParticle(
              x,
              y,
              size,
              0.38 + Math.random() * 0.42,
              color,
              Math.random() * Math.PI,
              0.8 + Math.random() * 2
            );
          }

          // A few irregular piles made of overlapping particles, not gradients.
          const pileCenters = [
            [0.24, 0.62],
            [0.47, 0.54],
            [0.68, 0.61],
            [0.82, 0.72]
          ];

          pileCenters.forEach(([px, py], pileIndex) => {
            const spreadX = rect.width * (0.09 + pileIndex * 0.005);
            const spreadY = rect.height * (0.07 + pileIndex * 0.004);

            for (let i = 0; i < 360; i++) {
              const theta = Math.random() * Math.PI * 2;
              const radius = Math.sqrt(Math.random());
              const x = rect.width * px + Math.cos(theta) * spreadX * radius;
              const y = rect.height * py + Math.sin(theta) * spreadY * radius;
              const size = 0.55 + Math.random() * 2.7;

              drawParticle(
                x,
                y,
                size,
                0.4 + Math.random() * 0.45,
                dustColors[Math.floor(Math.random() * dustColors.length)],
                Math.random() * Math.PI,
                0.8 + Math.random() * 2.2
              );
            }
          });
        }

        ctx.globalAlpha = 1;
        ctx.restore();

        if (finalPass) {
          benchDustFinished = true;
          bench.classList.add('is-buried');
        }
      };

      const spawnDust = (progress) => {
        if (!dustBurst) return;
        for (let i = 0; i < 4; i++) {
          const particle = document.createElement('i');
          particle.style.setProperty('--x', (5 + progress * 90) + '%');
          particle.style.setProperty('--dx', (-20 + Math.random() * 70) + 'px');
          particle.style.setProperty('--dy', (-18 - Math.random() * 58) + 'px');
          particle.style.setProperty('--spin', (-140 + Math.random() * 280) + 'deg');
          particle.style.setProperty('--size', (2 + Math.random() * 5) + 'px');
          dustBurst.appendChild(particle);
          setTimeout(() => particle.remove(), 1450);
        }
      };

      const runCut = () => {
        if (!cutStage || cutting || cutComplete) return;
        window.unyieldingTrailDiscover?.('workshop-saw', 'SHOP TRAIL FIND');
        cutting = true;

        if (bench && canvas && ctx) {
          clearBenchCompletely();
          bench.classList.add('is-cut-active');
        }

        if (reduceMotion) {
          cutStage.classList.add('is-cut');
          depositBenchDust(1, true);
          bench?.classList.remove('is-cut-active');
          cutComplete = true;
          cutting = false;
          return;
        }

        cutStage.classList.add('is-cutting');
        const started = performance.now();
        const duration = 3000;
        let lastDustAt = 0;
        let lastBenchDustAt = 0;

        const emit = (now) => {
          const progress = Math.min(1, (now - started) / duration);

          if (now - lastDustAt > 52) {
            spawnDust(progress);
            lastDustAt = now;
          }

          if (now - lastBenchDustAt > 72) {
            depositBenchDust(progress, false);
            lastBenchDustAt = now;
          }

          if (progress < 1 && cutting) {
            requestAnimationFrame(emit);
          } else {
            depositBenchDust(1, true);
            bench?.classList.remove('is-cut-active');
          }
        };
        requestAnimationFrame(emit);

        setTimeout(() => {
          cutStage.classList.add('is-cut');
          cutStage.classList.remove('is-cutting');
          cutComplete = true;
          cutting = false;
        }, duration);
      };

      cutStage?.addEventListener('pointerenter', () => {
        if (finePointer) runCut();
      });
      cutStage?.addEventListener('click', runCut);
      cutStage?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          runCut();
        }
      });

      const markCleanCoverage = (x, y, radius, rect) => {
        const cellWidth = rect.width / cleanGrid.columns;
        const cellHeight = rect.height / cleanGrid.rows;
        const effectiveRadius = radius * 0.92;

        for (let row = 0; row < cleanGrid.rows; row++) {
          for (let column = 0; column < cleanGrid.columns; column++) {
            const cellX = (column + 0.5) * cellWidth;
            const cellY = (row + 0.5) * cellHeight;
            const distance = Math.hypot(cellX - x, cellY - y);

            if (distance <= effectiveRadius) {
              cleanGrid.cells.add(row * cleanGrid.columns + column);
            }
          }
        }

        return cleanGrid.cells.size / (cleanGrid.columns * cleanGrid.rows);
      };

      const kickUpImpactDust = () => {
        if (!benchImpact || reduceMotion) return;
        benchImpact.replaceChildren();

        for (let i = 0; i < 34; i++) {
          const particle = document.createElement('i');
          const angle = (-165 + Math.random() * 150) * Math.PI / 180;
          const distance = 24 + Math.random() * 68;
          particle.style.setProperty('--impact-x', (Math.cos(angle) * distance).toFixed(1) + 'px');
          particle.style.setProperty('--impact-y', (Math.sin(angle) * distance - 8).toFixed(1) + 'px');
          particle.style.setProperty('--impact-r', (-160 + Math.random() * 320).toFixed(0) + 'deg');
          particle.style.setProperty('--impact-size', (1.5 + Math.random() * 4.5).toFixed(1) + 'px');
          particle.style.setProperty('--impact-delay', (Math.random() * 90).toFixed(0) + 'ms');
          benchImpact.appendChild(particle);
        }

        benchImpact.classList.remove('is-puffing');
        void benchImpact.offsetWidth;
        benchImpact.classList.add('is-puffing');
        setTimeout(() => benchImpact.replaceChildren(), 1050);
      };

      const revealCleanBench = () => {
        if (!bench || !canvas || !ctx || benchRevealComplete) return;
        benchRevealComplete = true;
        benchDustFinished = false;

        const rect = bench.getBoundingClientRect();
        ctx.clearRect(0, 0, rect.width, rect.height);

        bench.classList.remove('is-buried', 'is-cleaning');
        bench.classList.add('is-cleared');
        window.unyieldingTrailDiscover?.('workshop-dust', 'SAWDUST TRAIL FIND');

        requestAnimationFrame(() => {
          bench.classList.add('is-revealing');

          if (reduceMotion) {
            bench.classList.add('is-revealed');
            return;
          }

          setTimeout(kickUpImpactDust, 680);
          setTimeout(() => {
            bench.classList.remove('is-revealing');
            bench.classList.add('is-revealed');
          }, 1220);
        });
      };

      const clearDust = (event) => {
        if (!bench || !canvas || !ctx || !benchDustFinished || benchRevealComplete) return;
        if (!finePointer && !brushing) return;

        bench.classList.add('is-cleaning');

        const rect = bench.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;

        ctx.save();
        ctx.globalCompositeOperation = 'destination-out';
        const radius = finePointer ? 66 : 56;
        const gradient = ctx.createRadialGradient(x, y, 5, x, y, radius);
        gradient.addColorStop(0, 'rgba(0,0,0,1)');
        gradient.addColorStop(0.62, 'rgba(0,0,0,0.94)');
        gradient.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        const cleaned = markCleanCoverage(x, y, radius, rect);
        if (cleaned >= cleanGrid.threshold) revealCleanBench();
      };

      if (bench && canvas && ctx) {
        sizeBenchCanvas();
        clearBenchCompletely();

        bench.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'touch' || event.pointerType === 'pen') {
            brushing = true;
            clearDust(event);
          }
        });

        bench.addEventListener('pointermove', clearDust);

        const stopBrushing = () => {
          brushing = false;
        };

        bench.addEventListener('pointerup', stopBrushing);
        bench.addEventListener('pointercancel', stopBrushing);

        window.addEventListener('resize', () => {
          const wasDusty = benchDustFinished && !benchRevealComplete;
          const wasRevealed = benchRevealComplete;
          sizeBenchCanvas();

          if (wasDusty) {
            cleanGrid.cells.clear();
            depositBenchDust(1, true);
          }

          if (wasRevealed) {
            const rect = bench.getBoundingClientRect();
            ctx.clearRect(0, 0, rect.width, rect.height);
          }
        }, { passive: true });
      }
    })();
  </script>
</BaseLayout>
