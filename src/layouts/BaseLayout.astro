---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Eric Nolan | Unyielding Claw',
  description = 'Technical product leadership, trustworthy AI engineering, practical software, and physical builds by Eric Nolan.',
} = Astro.props;

const fullTitle = title === 'Eric Nolan | Unyielding Claw' ? title : `${title} | Eric Nolan`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/work/', label: 'Work' },
  { href: '/harness-engineering/', label: 'Harness Engineering' },
  { href: '/woodworking/', label: "Nolan's Workshop" },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eric Nolan',
  alternateName: 'Unyielding Claw',
  url: 'https://unyieldingclaw.com',
  sameAs: ['https://github.com/unyieldingclaw-dev'],
  jobTitle: 'Technical Product Manager',
  knowsAbout: [
    'Technical Product Management',
    'AI Engineering',
    'AI Governance',
    'Release Engineering',
    'Developer Productivity',
    'Harness Engineering',
    'Woodworking',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1f33" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <!-- Easter egg 000: Unyielding Claw was a name before it was a domain. -->
    <div class="cursor-spotlight" aria-hidden="true"></div>
    <div class="egg-toast" role="status" aria-live="polite"></div>

    <aside class="trail-guide" data-trail-guide hidden aria-label="Hidden trail guide">
      <button class="trail-guide__toggle" type="button" aria-expanded="false">
        <span aria-hidden="true">⌖</span>
        <strong>TRAIL <b data-trail-count>0/?</b></strong>
      </button>
      <div class="trail-guide__panel">
        <p class="trail-guide__kicker">UNYIELDING CLAW // FIELD GUIDE</p>
        <strong class="trail-guide__title">You found a trail marker.</strong>
        <p class="trail-guide__copy">Your prize is the knowledge that you clicked something nobody asked you to click.</p>
        <ol>
          <li data-trail-chapter="home" data-trail-total="3"><span>Basecamp</span><b>0/3</b></li>
          <li data-trail-chapter="work" data-trail-total="2"><span>Build Log</span><b>0/2</b></li>
          <li data-trail-chapter="harness" data-trail-total="3"><span>Systems Trail</span><b>0/3</b></li>
          <li data-trail-chapter="workshop" data-trail-total="3"><span>Sawdust Trail</span><b>0/3</b></li>
          <li data-trail-chapter="about" data-trail-total="3"><span>Origin Story</span><b>0/3</b></li>
          <li data-trail-chapter="contact" data-trail-total="2"><span>Basecamp Radio</span><b>0/2</b></li>
          <li class="trail-guide__secret" data-trail-chapter="offtrail" data-trail-total="1"><span>Off Trail</span><b>?</b></li>
        </ol>
        <p class="trail-guide__footer" data-trail-message>There are more. Probably.</p>
      </div>
    </aside>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Eric Nolan home">
          <span class="brand-mark egg-mark" data-egg="SACHEM // UNYIELDING CLAW" aria-hidden="true">UC</span>
          <span class="brand-copy">
            <strong>Eric Nolan</strong>
            <small>Unyielding Claw</small>
          </span>
        </a>

        <nav aria-label="Primary navigation">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="footer-brand egg-signature" data-egg="Built with code, sawdust, smoke & stubbornness." href="/">Eric Nolan · Unyielding Claw</a>
          <p>Technical product leadership, AI engineering systems, practical software, and things built by hand.</p>
        </div>
        <div>
          <p class="footer-label">Elsewhere</p>
          <p><a href="https://github.com/unyieldingclaw-dev">GitHub</a> · <a href="/contact/">Contact</a></p>
        </div>
        <div>
          <p class="footer-label">Boundaries</p>
          <p>Public-safe personal work only. Employer code, data, credentials, and confidential implementation details are excluded.</p>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} Eric Nolan.</span>
        <span>Site code MIT · authored content all rights reserved unless stated otherwise.</span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        const eggToast = document.querySelector('.egg-toast');
        let eggBuffer = '';
        let eggTimer;

        const showToast = (message, duration = 1800) => {
          if (!eggToast) return;
          clearTimeout(eggTimer);
          eggToast.textContent = message;
          eggToast.classList.add('is-visible');
          eggTimer = setTimeout(() => eggToast.classList.remove('is-visible'), duration);
        };

        document.addEventListener('keydown', (event) => {
          const target = event.target;
          if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target?.isContentEditable) return;
          if (event.key.length !== 1) return;

          eggBuffer = (eggBuffer + event.key.toLowerCase()).slice(-12);

          if (eggBuffer.endsWith('miz')) {
            showToast('ZOU!');
            window.unyieldingTrailDiscover?.('home-miz', 'MIZ // ZOU');
            eggBuffer = '';
          }
        });

        const trailGuide = document.querySelector('[data-trail-guide]');
        const trailToggle = trailGuide?.querySelector('.trail-guide__toggle');
        const trailCount = trailGuide?.querySelector('[data-trail-count]');
        const trailMessage = trailGuide?.querySelector('[data-trail-message]');
        const trailKey = 'unyielding-claw-trail-v2';
        const legacyTrailKey = 'unyielding-claw-trail-v1';
        const trailTotal = 17;
        let foundMarkers = [];

        const legacyMap = {
          home: 'home-basecamp',
          work: 'work-buildlog',
          harness: 'harness-trail',
          workshop: 'workshop-trail',
          about: 'about-origin',
          contact: 'contact-radio',
        };

        try {
          foundMarkers = JSON.parse(localStorage.getItem(trailKey) || '[]');
          if (!Array.isArray(foundMarkers)) foundMarkers = [];

          if (foundMarkers.length === 0) {
            const legacy = JSON.parse(localStorage.getItem(legacyTrailKey) || '[]');
            if (Array.isArray(legacy)) {
              foundMarkers = legacy.map((id) => legacyMap[id]).filter(Boolean);
            }
          }
        } catch {
          foundMarkers = [];
        }

        const saveTrail = () => {
          try {
            localStorage.setItem(trailKey, JSON.stringify([...new Set(foundMarkers)]));
          } catch {}
        };

        const renderTrail = () => {
          if (!trailGuide) return;
          const unique = [...new Set(foundMarkers)];
          trailGuide.hidden = unique.length === 0;

          if (trailCount) {
            trailCount.textContent = unique.length < 6
              ? unique.length + '/?'
              : unique.length + '/' + trailTotal;
          }

          trailGuide.querySelectorAll('[data-trail-chapter]').forEach((item) => {
            const chapter = item.getAttribute('data-trail-chapter');
            const total = Number(item.getAttribute('data-trail-total') || 0);
            const found = unique.filter((id) => id.startsWith(chapter + '-')).length;
            item.classList.toggle('is-found', found >= total && total > 0);
            item.classList.toggle('has-progress', found > 0);

            const status = item.querySelector('b');
            if (!status) return;

            if (chapter === 'offtrail' && found === 0) {
              status.textContent = '?';
            } else {
              status.textContent = found + '/' + total;
            }
          });

          if (trailMessage) {
            trailMessage.textContent = unique.length >= trailTotal
              ? 'TRAIL COMPLETE // Apparently curiosity is a core competency.'
              : unique.length >= 12
                ? 'At this point you are either thorough or avoiding work.'
                : unique.length >= 6
                  ? 'The map got bigger. You knew it would.'
                  : unique.length >= 3
                    ? 'You are here. Probably. Context matters.'
                    : 'There are more. Definitely.';
          }
        };

        const discoverTrail = (id, toast = 'TRAIL FIND') => {
          if (!id || foundMarkers.includes(id)) return false;
          foundMarkers.push(id);
          saveTrail();
          renderTrail();
          showToast(toast + ' // ' + [...new Set(foundMarkers)].length + '/?', 2200);
          return true;
        };

        window.unyieldingTrailDiscover = discoverTrail;

        document.querySelectorAll('[data-trail-marker]').forEach((marker) => {
          marker.addEventListener('click', () => {
            const id = marker.getAttribute('data-trail-marker');
            if (discoverTrail(id, 'TRAIL MARKER FOUND')) marker.classList.add('is-found');
          });
        });

        document.querySelectorAll('[data-trail-hover]').forEach((target) => {
          let discovered = false;
          const findIt = () => {
            if (discovered) return;
            discovered = discoverTrail(target.getAttribute('data-trail-hover'), 'TRAIL DETAIL FOUND');
          };

          target.addEventListener('pointerenter', findIt, { passive: true });
          target.addEventListener('focusin', findIt);
          target.addEventListener('click', findIt);
        });

        document.querySelectorAll('[data-trail-auto]').forEach((target) => {
          discoverTrail(target.getAttribute('data-trail-auto'), 'OFF-TRAIL FIND');
        });

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const target = event.target.closest('[data-trail-discovery]');
          if (!target) return;
          discoverTrail(target.getAttribute('data-trail-discovery'), 'TRAIL DETAIL FOUND');
        });

        trailToggle?.addEventListener('click', () => {
          const open = trailGuide.classList.toggle('is-open');
          trailToggle.setAttribute('aria-expanded', String(open));
        });

        renderTrail();

        if (reduceMotion) return;

        document.documentElement.classList.add('motion-enabled');

        const revealTargets = document.querySelectorAll(
          '.section-heading, .project-card, .principle, .feature-note, .identity-card, .workshop-card, .case-content > section, .proof-module, .range-card, .manifesto-grid, .work-console, .harness-node, .harness-question, .rule-card, .bench-note, .about-stack__card, .career-timeline article, .personal-tile, .contact-action, .contact-topic-grid article, .case-flow > section, .bridge-card'
        );

        revealTargets.forEach((el) => el.classList.add('reveal-ready'));

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });

          revealTargets.forEach((el) => observer.observe(el));
        } else {
          revealTargets.forEach((el) => el.classList.add('is-revealed'));
        }

        if (!finePointer) return;

        const spotlight = document.querySelector('.cursor-spotlight');
        let spotlightFrame;

        if (spotlight) {
          const moveSpotlight = (event) => {
            cancelAnimationFrame(spotlightFrame);
            spotlightFrame = requestAnimationFrame(() => {
              spotlight.style.setProperty('--cursor-x', event.clientX + 'px');
              spotlight.style.setProperty('--cursor-y', event.clientY + 'px');
              spotlight.classList.add('is-active');
            });
          };

          document.addEventListener('pointermove', moveSpotlight, { passive: true });
          document.addEventListener('pointerleave', () => spotlight.classList.remove('is-active'));
          window.addEventListener('blur', () => spotlight.classList.remove('is-active'));
        }

        const tiltCards = document.querySelectorAll('.project-card');

        tiltCards.forEach((card) => {
          let frame;

          const reset = () => {
            cancelAnimationFrame(frame);
            card.style.setProperty('--tilt-x', '0deg');
            card.style.setProperty('--tilt-y', '0deg');
            card.style.setProperty('--glow-x', '50%');
            card.style.setProperty('--glow-y', '50%');
            card.classList.remove('is-tilting');
          };

          card.addEventListener('pointerenter', () => card.classList.add('is-tilting'));

          card.addEventListener('pointermove', (event) => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(() => {
              const rect = card.getBoundingClientRect();
              const x = event.clientX - rect.left;
              const y = event.clientY - rect.top;
              const px = x / rect.width;
              const py = y / rect.height;
              const rotateY = (px - 0.5) * 9;
              const rotateX = (0.5 - py) * 7;

              card.style.setProperty('--tilt-x', rotateX.toFixed(2) + 'deg');
              card.style.setProperty('--tilt-y', rotateY.toFixed(2) + 'deg');
              card.style.setProperty('--glow-x', (px * 100).toFixed(1) + '%');
              card.style.setProperty('--glow-y', (py * 100).toFixed(1) + '%');
            });
          });

          card.addEventListener('pointerleave', reset);
          card.addEventListener('blur', reset, true);
        });

        const hero = document.querySelector('.hero');
        const heroPanel = document.querySelector('.ai-proof-board, .hero-panel');

        if (hero && heroPanel) {
          let heroFrame;

          hero.addEventListener('pointermove', (event) => {
            cancelAnimationFrame(heroFrame);
            heroFrame = requestAnimationFrame(() => {
              const rect = hero.getBoundingClientRect();
              const px = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
              const py = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));

              hero.style.setProperty('--hero-x', (px * 100).toFixed(1) + '%');
              hero.style.setProperty('--hero-y', (py * 100).toFixed(1) + '%');
              heroPanel.style.setProperty('--panel-x', ((px - 0.5) * 7).toFixed(2) + 'px');
              heroPanel.style.setProperty('--panel-y', ((py - 0.5) * 7).toFixed(2) + 'px');
            });
          });

          hero.addEventListener('pointerleave', () => {
            hero.style.setProperty('--hero-x', '78%');
            hero.style.setProperty('--hero-y', '18%');
            heroPanel.style.setProperty('--panel-x', '0px');
            heroPanel.style.setProperty('--panel-y', '0px');
          });
        }
      })();
    </script>
  </body>
</html>
