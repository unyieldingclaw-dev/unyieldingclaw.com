---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid hero-grid--wow">
      <div class="hero-copy">
        <div class="hero-badges" aria-label="Professional focus">
          <span>Technical Product Manager</span>
          <span class="badge-electric">Hands-on AI Development</span>
          <span class="badge-emerald">AI Governance</span>
        </div>

        <p class="hero-kicker">I don't just roadmap AI.</p>
        <h1>I build the systems that make AI <em>useful.</em></h1>
        <p class="lede">
          I work in the awkward middle between product strategy and the code that has to survive contact with reality. That means AI-assisted products, developer tools, context and memory systems, and enough guardrails to know when the clever part went sideways.
        </p>

        <div class="hero-actions">
          <a class="button button-pop" href="/work/">See what I've built <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="/harness-engineering/">How I engineer AI</a>
        </div>

        <div class="hero-tech-line" aria-label="AI development capabilities">
          <span>Python</span>
          <span>FastAPI</span>
          <span>LangGraph</span>
          <span>Local LLMs</span>
          <span>Agent orchestration</span>
          <span>Evaluation</span>
          <span class="egg-inline" data-egg="Because YOLO is not governance.">Guardrails</span>
        </div>
      </div>

      <div class="ai-proof-board" aria-label="Hands-on AI development proof">
        <div class="proof-board-top">
          <span class="proof-board-label">AI DEVELOPMENT // BUILD LOG</span>
          <span class="proof-board-live"><i></i> BUILDING</span>
        </div>
        <button class="trail-marker trail-marker--board" type="button" data-trail-marker="home-basecamp" aria-label="Hidden trail marker: Basecamp">◇</button>

        <a class="proof-module proof-module--blue" href="/work/personal-memory-bank/">
          <span class="proof-module-index">01</span>
          <div>
            <strong>Context & Memory Systems</strong>
            <p>Authority, freshness, provenance, drift detection, hooks, and context ceilings.</p>
          </div>
        </a>

        <a class="proof-module proof-module--emerald" href="/work/ai-code-review-agent/">
          <span class="proof-module-index">02</span>
          <div>
            <strong>Agent & Tool Orchestration</strong>
            <p>Specialist agents, local inference, APIs, workflow routing, bounded execution.</p>
          </div>
        </a>

        <a class="proof-module proof-module--copper" href="/harness-engineering/">
          <span class="proof-module-index">03</span>
          <div>
            <strong>Verification & Governance</strong>
            <p>Independent review, CI gates, security controls, confidence, and failure handling.</p>
          </div>
        </a>

        <div class="proof-board-punch egg-inline" data-egg="Yes, I know PMB + ACR + HE sounds like a law firm." data-trail-hover="home-proof" tabindex="0" role="note" aria-label="Open source: PMB, ACR, and Harness Engineering. Hidden note: yes, I know it sounds like a law firm.">
          <span>OPEN SOURCE</span>
          <strong>PMB + ACR + HE</strong>
          <small>Code, commits, and case studies. Adjectives can wait.</small>
        </div>
      </div>
    </div>
  </section>

  <div class="proof-ribbon" aria-label="Selected AI engineering evidence">
    <div class="proof-track">
      <span>OPEN-SOURCE AI GOVERNANCE</span><b>◆</b>
      <span>15-AGENT LOCAL CODE REVIEW</span><b>◆</b>
      <span>CONTEXT AUTHORITY + PROVENANCE</span><b>◆</b>
      <span>LOCAL LLM INFERENCE</span><b>◆</b>
      <span>HUMAN-IN-THE-LOOP AUTOMATION</span><b>◆</b>
      <span>BUILD · GOVERN · VERIFY · SHIP</span><b>◆</b>
      <span aria-hidden="true">OPEN-SOURCE AI GOVERNANCE</span><b aria-hidden="true">◆</b>
      <span aria-hidden="true">15-AGENT LOCAL CODE REVIEW</span><b aria-hidden="true">◆</b>
      <span aria-hidden="true">CONTEXT AUTHORITY + PROVENANCE</span><b aria-hidden="true">◆</b>
      <span aria-hidden="true">LOCAL LLM INFERENCE</span><b aria-hidden="true">◆</b>
      <span aria-hidden="true">HUMAN-IN-THE-LOOP AUTOMATION</span><b aria-hidden="true">◆</b>
      <span aria-hidden="true">BUILD · GOVERN · VERIFY · SHIP</span><b aria-hidden="true">◆</b>
    </div>
  </div>

  <section class="section section--projects">
    <div class="shell">
      <div class="section-heading section-heading--punch">
        <div>
          <p class="eyebrow">Selected AI + product work</p>
          <h2>Here's the part I can actually show you.</h2>
        </div>
        <p class="section-intro">
          I can put “AI” in a headline all day. These are the projects I point to instead: things I built, decisions I had to defend, and a few places where the boring guardrail turned out to matter more than the clever model call.
        </p>
      </div>

      <div class="project-grid">
        <ProjectCard
          title="Personal Memory Bank"
          href="/work/personal-memory-bank/"
          eyebrow="AI engineering · Context systems"
          description="Keeps AI coding sessions from waking up with amnesia—and keeps old context from quietly pretending it is still true."
          status="Open source"
          tags={['Context engineering', 'Governance', 'CLI', 'CI']}
          tone="blue"
        />
        <ProjectCard
          title="AI Code Review Agent"
          href="/work/ai-code-review-agent/"
          eyebrow="Local AI · Multi-agent tooling"
          description="Local code review with separate specialist lenses, sanitized diffs, confidence-aware findings, and enough structure to keep fifteen opinions from becoming one loud opinion."
          status="Open source"
          tags={['Ollama', 'Agents', 'Review', 'Security']}
          tone="emerald"
        />
        <ProjectCard
          title="Harness Engineering"
          href="/harness-engineering/"
          eyebrow="AI systems · Research framework"
          description="My engineering framework for the layer around the model: context, memory, instructions, tools, orchestration, governance, evaluation, and execution boundaries."
          status="Public research"
          tags={['AI architecture', 'Evaluation', 'Governance', 'Execution']}
          tone="slate"
          linkLabel="Explore the framework"
        />
        <ProjectCard
          title="PitLogic"
          href="/work/pitlogic/"
          eyebrow="Product engineering · Live telemetry"
          description="A deployed BBQ telemetry PWA with device integration, alarms, stall detection, finish-time prediction, offline behavior, and an automated test suite."
          status="Open source"
          tags={['React', 'Telemetry', 'PWA', 'Testing']}
          tone="copper"
        />
      </div>

      <p class="section-cta"><a class="text-link" href="/work/">See Side Quest Atlas, Tipsy Bunghole, Bowling Tracker, and the full project set →</a></p>
    </div>
  </section>

  <section class="section section--dark section--ai-manifesto">
    <div class="shell">
      <div class="manifesto-grid">
        <div class="manifesto-head">
          <p class="eyebrow">How I build AI</p>
          <h2>A smart model can still make a lousy product.</h2>
        </div>

        <div class="manifesto-copy">
          <p>
            Prompting matters, but it is rarely the part that wakes somebody up later. I spend more time on context, tool contracts, state, retries, approval gates, privacy, verification, and making sure a bad answer fails loudly enough that somebody notices.
          </p>
          <p>
            The model gets the demo. The surrounding engineering gets the pager.
          </p>
          <a class="button manifesto-button" href="/harness-engineering/">Enter Harness Engineering →</a>
        </div>
      </div>

      <div class="principle-grid principle-grid--punch">
        <article class="principle">
          <span>BUILD</span>
          <h3>Get close to the code.</h3>
          <p>APIs, Python, orchestration, local models, data boundaries, developer workflows, and the actual implementation constraints.</p>
        </article>
        <article class="principle">
          <span>GOVERN</span>
          <h3>Bound the machine.</h3>
          <p>Give automation explicit authority, deterministic controls, and human approval where consequences deserve judgment.</p>
        </article>
        <article class="principle">
          <span>VERIFY</span>
          <h3>Do not let AI grade itself.</h3>
          <p>Use independent review, tests, CI, structured evidence, and observable failure instead of quiet confidence theater.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--range">
    <div class="shell range-grid">
      <div class="range-lead">
        <button
          class="trail-marker trail-marker--range"
          type="button"
          data-trail-marker="home-range"
          aria-label="Hidden trail marker: More than AI"
        >◇</button>
        <p class="eyebrow">More than AI</p>
        <h2>I build because I like solving things.</h2>
        <p>
          AI is central to my professional work. The rest is here because I apparently solve hobbies the same way: build something, use it, notice what is annoying, and go back to the shop—or the code.
        </p>
      </div>

      <div class="range-cards">
        <a class="range-card range-card--scouting" href="/about/">
          <span>Leadership</span>
          <strong>Eagle Scout · Sachem</strong>
          <small>Service, mentoring, preparedness, and decades in Scouting.</small>
        </a>
        <a class="range-card range-card--workshop" href="/woodworking/">
          <span>Maker</span>
          <strong>Nolan's Workshop</strong>
          <small>Jigs, tools, furniture, work surfaces, finishing, and sawdust.</small>
        </a>
        <a class="range-card range-card--products" href="/work/">
          <span>Product builder</span>
          <strong>Real workflows first</strong>
          <small>Software when software fits. No agent required.</small>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
