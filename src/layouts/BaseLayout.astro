---
import '../styles/global.css';
import '../styles/brand.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Eric Nolan | Unyielding Claw',
  description = 'Technical product leadership, AI engineering and governance, developer systems, practical software, and physical builds by Eric Nolan.',
} = Astro.props;

const fullTitle = title === 'Eric Nolan | Unyielding Claw' ? title : `${title} | Eric Nolan`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pathname = Astro.url.pathname;
const isWorkshopPage = pathname.startsWith('/woodworking');
const socialImageURL = new URL(
  isWorkshopPage ? '/social-card-nolans-workshop.jpg?v=3' : '/social-card-unyielding-claw.jpg?v=3',
  Astro.site ?? Astro.url.origin,
);
const socialImageAlt = isWorkshopPage
  ? "Nolan's Workshop sawblade emblem on a warm woodgrain and circuit-board background"
  : "Unyielding Claw sawblade emblem on a dark technical circuit-board background";
const themeColor = isWorkshopPage ? '#985a35' : '#0b1f33';

const navItems = [
  { href: '/work/', label: 'Work' },
  { href: '/harness-engineering/', label: 'Harness Engineering' },
  { href: '/woodworking/', label: "Nolan's Workshop" },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eric Nolan',
  alternateName: 'Unyielding Claw',
  url: 'https://unyieldingclaw.com',
  sameAs: ['https://github.com/unyieldingclaw-dev', 'https://www.linkedin.com/in/ericnolan1/'],
  jobTitle: 'Technical Product Manager',
  knowsAbout: [
    'Technical Product Management',
    'AI Engineering',
    'AI Governance',
    'Release Engineering',
    'Developer Productivity',
    'Harness Engineering',
    'Woodworking',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <div class="cursor-spotlight" aria-hidden="true"></div>
    <!-- Easter egg 000: Unyielding Claw was a name before it was a domain. -->
    <div class="egg-toast" role="status" aria-live="polite"></div>
    <div class="miz-takeover" data-miz-takeover role="status" aria-live="assertive" aria-atomic="true" aria-hidden="true">
      <strong>ZOU!</strong>
    </div>

    <aside class="trail-guide" data-trail-guide hidden aria-label="Hidden trail guide">
      <button class="trail-guide__toggle" type="button" aria-expanded="false" aria-controls="trail-guide-panel">
        <span aria-hidden="true">⌖</span>
        <strong>TRAIL <b data-trail-count>0/?</b></strong>
      </button>
      <div class="trail-guide__panel" id="trail-guide-panel" aria-hidden="true" inert>
        <p class="trail-guide__kicker">UNYIELDING CLAW // FIELD GUIDE</p>
        <strong class="trail-guide__title">Trail progress</strong>
        <p class="trail-guide__copy" data-trail-summary>Explore the site. Hidden markers and interactive details both count.</p>
        <ol>
          <li data-trail-chapter="home" data-trail-total="3"><span>Home</span><b>0/3</b></li>
          <li data-trail-chapter="work" data-trail-total="2"><span>Work</span><b>0/2</b></li>
          <li data-trail-chapter="harness" data-trail-total="3"><span>Harness Engineering</span><b>0/3</b></li>
          <li data-trail-chapter="workshop" data-trail-total="3"><span>Nolan's Workshop</span><b>0/3</b></li>
          <li data-trail-chapter="about" data-trail-total="3"><span>About</span><b>0/3</b></li>
          <li data-trail-chapter="contact" data-trail-total="2"><span>Contact</span><b>0/2</b></li>
          <li class="trail-guide__secret" data-trail-chapter="offtrail" data-trail-total="1"><span>Bonus / Off Trail</span><b>?</b></li>
        </ol>
        <p class="trail-guide__footer" data-trail-message>There are more. Probably.</p>
        <div class="trail-guide__reset-wrap">
          <button type="button" class="trail-guide__reset" data-trail-reset data-reset-label="RESET TRAIL">RESET TRAIL</button>
          <small>Handing the screen to somebody else? Start clean.</small>
        </div>
      </div>
    </aside>

    <div
      class="trail-complete"
      data-trail-complete
      role="dialog"
      aria-modal="true"
      aria-labelledby="trail-complete-title"
      aria-describedby="trail-complete-description"
      aria-hidden="true"
      inert
    >
      <div class="trail-complete__mission" aria-hidden="true">
        <span>CONGRATULATIONS!</span>
        <strong>YOU COMPLETED YOUR MISSION.</strong>
        <small>NOW THERE IS ONE THING LEFT TO DO...</small>
        <b>HIRE NOLAN!</b>
      </div>
      <div class="trail-complete__card">
        <div class="trail-badge" aria-hidden="true">
          <img class="trail-badge__mark" src="/social-card-unyielding-claw.jpg" width="68" height="68" alt="" aria-hidden="true" />
          <b>EXPLORER</b>
        </div>
        <p>TRAIL GUIDE // RANK EARNED</p>
        <strong id="trail-complete-title">Unyielding Explorer</strong>
        <small id="trail-complete-description">You found everything nobody asked you to find.</small>
        <button type="button" data-trail-pin>PIN THE BADGE</button>
        <button type="button" class="trail-complete__continue" data-trail-continue>CONTINUE EXPLORING</button>
        <button type="button" class="trail-complete__reset" data-trail-reset data-reset-label="RESET FOR NEXT EXPLORER">RESET FOR NEXT EXPLORER</button>
      </div>
    </div>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-describedby="brand-egg-clue">
          <span class="brand-mark egg-mark" data-egg="SACHEM // UNYIELDING CLAW" aria-hidden="true"><img src="/brand-mark.svg?v=3" alt="" width="100" height="100" /></span>
          <span class="brand-copy">
            <strong>Eric Nolan</strong>
            <small>Unyielding Claw</small>
          </span>
        </a>
        <span class="sr-only" id="brand-egg-clue">Hidden note: Sachem, Unyielding Claw.</span>

        <button
          class="mobile-menu-toggle"
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="primary-nav"
          aria-label="Menu"
        >
          <span class="mobile-menu-toggle__label" data-menu-label>Menu</span>
          <span class="mobile-menu-toggle__icon" aria-hidden="true"></span>
        </button>
        <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="footer-brand egg-signature" data-egg="Tigers, Jayhawks, and Cyclones... oh my." href="/" aria-describedby="footer-school-clue">Eric Nolan · Unyielding Claw</a>
          <span class="sr-only" id="footer-school-clue">Hidden clue: Tigers, Jayhawks, and Cyclones... oh my.</span>
          <p>Technical product leadership, AI engineering systems, practical software, and things built by hand.</p>
        </div>
        <div>
          <p class="footer-label">Elsewhere</p>
          <p><a href="https://www.linkedin.com/in/ericnolan1/">LinkedIn</a> · <a href="https://github.com/unyieldingclaw-dev">GitHub</a> · <a href="/contact/">Contact</a></p>
        </div>
        <div>
          <p class="footer-label">Boundaries</p>
          <p>Public-safe personal work only. Employer code, data, credentials, and confidential implementation details are excluded.</p>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} Eric Nolan.</span>
        <span>
          Site code MIT · authored content all rights reserved unless stated otherwise.
          <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">PAUSE AUTO MOTION</button>
          <button
            type="button"
            class="egg-inline footer-key-clue"
            data-egg="Here's a shout out to ol MIZZOU. (type your 3 letters)."
            data-miz-keyboard
            aria-expanded="false"
            aria-controls="miz-mobile-entry"
            aria-describedby="miz-key-clue"
          >⌨</button>
          <span class="sr-only" id="miz-key-clue">Easter egg clue: Here's a shout out to ol MIZZOU. Type your three letters.</span>
          <span class="miz-mobile-entry" id="miz-mobile-entry" data-miz-entry hidden>
            <label class="sr-only" for="miz-mobile-input">Type your three-letter Mizzou call</label>
            <input
              id="miz-mobile-input"
              data-miz-input
              type="text"
              maxlength="3"
              inputmode="text"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              enterkeyhint="done"
              placeholder="___"
              aria-label="Type your three-letter Mizzou call"
            />
          </span>
        </span>
      </div>
    </footer>

<script src="../scripts/site-interactions.js"></script>
  </body>
</html>
