    </div>
  </header>

  <section class="section">
    <div class="shell prose">
      <h2>GitHub</h2>
      <p><a href="https://github.com/unyieldingclaw-dev">github.com/unyieldingclaw-dev →</a></p>

      <h2>Email</h2>
      <p><a href="mailto:unyieldingclaw@gmail.com">unyieldingclaw@gmail.com</a></p>
    </div>
  </section>
</BaseLayout>
