<CaseStudyLayout
  title="Personal Memory Bank"
  description="Case study: persistent, governed project context for AI-assisted software development."
  eyebrow="AI engineering · Developer workflow"
  lede="AI coding assistants can remember a lot and still forget the one decision that made yesterday's code make sense. PMB is my attempt to make project memory useful without letting stale notes become accidental law."
  status="Active"
  access="Open source · MIT"
  tags={['Context engineering', 'Governance', 'CLI', 'CI']}
