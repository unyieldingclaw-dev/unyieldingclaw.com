---
interface Props {
  title: string;
  href: string;
  eyebrow: string;
  description: string;
  status?: string;
  tags?: string[];
  tone?: 'blue' | 'emerald' | 'copper' | 'slate' | 'gold';
  linkLabel?: string;
  visual?: 'pmb' | 'acr' | 'harness' | 'sidequest' | 'pitlogic' | 'tipsy' | 'bowling';
}

const {
  title,
  href,
  eyebrow,
  description,
  status,
  tags = [],
  tone = 'blue',
  linkLabel = 'Read case study',
  visual,
} = Astro.props;

const inferredVisual =
  visual ??
  (href.includes('/personal-memory-bank/') ? 'pmb' :
   href.includes('/ai-code-review-agent/') ? 'acr' :
   href.includes('/harness-engineering/') ? 'harness' :
   href.includes('/side-quest-atlas/') ? 'sidequest' :
   href.includes('/pitlogic/') ? 'pitlogic' :
   href.includes('/tipsy-bunghole/') ? 'tipsy' :
   href.includes('/bowling-tracker/') ? 'bowling' :
   undefined);

const mark = title
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase())
  .join('');
---

<a
  class={`project-card project-card--${tone}${inferredVisual ? ` project-card--visual project-card--${inferredVisual}` : ''}`}
  href={href}
  aria-label={`${title}: ${linkLabel}`}
>
  {inferredVisual && <div class={`project-card__art project-card__art--${inferredVisual}`} aria-hidden="true"></div>}
  <div class="project-card__veil" aria-hidden="true"></div>
  <div class="project-card__mark" aria-hidden="true">{mark}</div>
  <div class="project-card__top">
    <p class="project-kicker">{eyebrow}</p>
    {status && <span class="status-chip">{status}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list" aria-label="Project themes">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
  <span class="project-link">{linkLabel} <span aria-hidden="true">→</span></span>
</a>
