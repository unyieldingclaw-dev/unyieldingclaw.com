---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Eric Nolan | Unyielding Claw',
  description = 'Technical product leadership, trustworthy AI engineering, practical software, and physical builds by Eric Nolan.',
} = Astro.props;

const fullTitle = title === 'Eric Nolan | Unyielding Claw' ? title : `${title} | Eric Nolan`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/work/', label: 'Work' },
  { href: '/harness-engineering/', label: 'Harness Engineering' },
  { href: '/woodworking/', label: "Nolan's Workshop" },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eric Nolan',
  alternateName: 'Unyielding Claw',
  url: 'https://unyieldingclaw.com',
  sameAs: ['https://github.com/unyieldingclaw-dev'],
  jobTitle: 'Technical Product Manager',
  knowsAbout: [
    'Technical Product Management',
    'AI Engineering',
    'AI Governance',
    'Release Engineering',
    'Developer Productivity',
    'Harness Engineering',
    'Woodworking',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1f33" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Eric Nolan home">
          <span class="brand-mark" aria-hidden="true">UC</span>
          <span class="brand-copy">
            <strong>Eric Nolan</strong>
            <small>Unyielding Claw</small>
          </span>
        </a>

        <nav aria-label="Primary navigation">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="footer-brand" href="/">Eric Nolan · Unyielding Claw</a>
          <p>Technical product leadership, AI engineering systems, practical software, and things built by hand.</p>
        </div>
        <div>
          <p class="footer-label">Elsewhere</p>
          <p><a href="https://github.com/unyieldingclaw-dev">GitHub</a> · <a href="/contact/">Contact</a></p>
        </div>
        <div>
          <p class="footer-label">Boundaries</p>
          <p>Public-safe personal work only. Employer code, data, credentials, and confidential implementation details are excluded.</p>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} Eric Nolan.</span>
        <span>Site code MIT · authored content all rights reserved unless stated otherwise.</span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        if (reduceMotion) return;

        document.documentElement.classList.add('motion-enabled');

        const revealTargets = document.querySelectorAll(
          '.section-heading, .project-card, .principle, .feature-note, .identity-card, .workshop-card, .case-content > section, .proof-module, .range-card, .manifesto-grid'
        );

        revealTargets.forEach((el) => el.classList.add('reveal-ready'));

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });

          revealTargets.forEach((el) => observer.observe(el));
        } else {
          revealTargets.forEach((el) => el.classList.add('is-revealed'));
        }

        if (!finePointer) return;

        const tiltCards = document.querySelectorAll('.project-card');

        tiltCards.forEach((card) => {
          let frame;

          const reset = () => {
            cancelAnimationFrame(frame);
            card.style.setProperty('--tilt-x', '0deg');
            card.style.setProperty('--tilt-y', '0deg');
            card.style.setProperty('--glow-x', '50%');
            card.style.setProperty('--glow-y', '50%');
            card.classList.remove('is-tilting');
          };

          card.addEventListener('pointerenter', () => card.classList.add('is-tilting'));

          card.addEventListener('pointermove', (event) => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(() => {
              const rect = card.getBoundingClientRect();
              const x = event.clientX - rect.left;
              const y = event.clientY - rect.top;
              const px = x / rect.width;
              const py = y / rect.height;
              const rotateY = (px - 0.5) * 9;
              const rotateX = (0.5 - py) * 7;

              card.style.setProperty('--tilt-x', rotateX.toFixed(2) + 'deg');
              card.style.setProperty('--tilt-y', rotateY.toFixed(2) + 'deg');
              card.style.setProperty('--glow-x', (px * 100).toFixed(1) + '%');
              card.style.setProperty('--glow-y', (py * 100).toFixed(1) + '%');
            });
          });

          card.addEventListener('pointerleave', reset);
          card.addEventListener('blur', reset, true);
        });

        const hero = document.querySelector('.hero');
        const heroPanel = document.querySelector('.ai-proof-board, .hero-panel');

        if (hero && heroPanel) {
          let heroFrame;

          hero.addEventListener('pointermove', (event) => {
            cancelAnimationFrame(heroFrame);
            heroFrame = requestAnimationFrame(() => {
              const rect = hero.getBoundingClientRect();
              const px = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
              const py = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));

              hero.style.setProperty('--hero-x', (px * 100).toFixed(1) + '%');
              hero.style.setProperty('--hero-y', (py * 100).toFixed(1) + '%');
              heroPanel.style.setProperty('--panel-x', ((px - 0.5) * 7).toFixed(2) + 'px');
              heroPanel.style.setProperty('--panel-y', ((py - 0.5) * 7).toFixed(2) + 'px');
            });
          });

          hero.addEventListener('pointerleave', () => {
            hero.style.setProperty('--hero-x', '78%');
            hero.style.setProperty('--hero-y', '18%');
            heroPanel.style.setProperty('--panel-x', '0px');
            heroPanel.style.setProperty('--panel-y', '0px');
          });
        }
      })();
    </script>
  </body>
</html>
