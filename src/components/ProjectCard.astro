---
interface Props {
  title: string;
  href: string;
  eyebrow: string;
  description: string;
  status?: string;
  tags?: string[];
  tone?: 'blue' | 'emerald' | 'copper' | 'slate' | 'gold';
  linkLabel?: string;
}

const {
  title,
  href,
  eyebrow,
  description,
  status,
  tags = [],
  tone = 'blue',
  linkLabel = 'Read case study',
} = Astro.props;

const mark = title
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase())
  .join('');
---

<a class={`project-card project-card--${tone}`} href={href} aria-label={`${title}: ${linkLabel}`}>
  <div class="project-card__mark" aria-hidden="true">{mark}</div>
  <div class="project-card__top">
    <p class="project-kicker">{eyebrow}</p>
    {status && <span class="status-chip">{status}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list" aria-label="Project themes">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
  <span class="project-link">{linkLabel} <span aria-hidden="true">→</span></span>
</a>
